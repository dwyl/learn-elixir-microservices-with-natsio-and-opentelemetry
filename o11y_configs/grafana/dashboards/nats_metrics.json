  "description": "NATS messaging metrics captured by PromExPlugin.NatsMetrics using Gnat telemetry. Displays publish latency, message throughput, request/reply patterns, and subscriptions across all services.",
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": "prometheus",
      "description": "Average publish latency per service and topic (how long does Gnat.pub() take?)",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1000
              },
              {
                "color": "red",
                "value": 5000
              }
            ]
          },
          "unit": "µs"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(gnat_pub_duration_microseconds_sum{job=~\"$service\", topic=~\"$topic\"}[1m]) / rate(gnat_pub_duration_microseconds_count{job=~\"$service\", topic=~\"$topic\"}[1m])",
          "legendFormat": "{{job}} - {{topic}}",
          "refId": "A"
        }
      ],
      "title": "Publish Latency (avg)",
      "type": "timeseries"
    },
    {
      "datasource": "prometheus",
      "description": "95th percentile publish latency - tracks worst-case performance",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2500
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          },
          "unit": "µs"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": ["last", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, rate(gnat_pub_duration_microseconds_bucket{job=~\"$service\", topic=~\"$topic\"}[1m]))",
          "legendFormat": "{{job}} - {{topic}}",
          "refId": "A"
        }
      ],
      "title": "Publish Latency (p95)",
      "type": "timeseries"
    },
