# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================
# IMPORTANT: Replace all default passwords and secrets before deploying!
# Copy this file to your VPS and customize the values below.

# ============================================
# Build Configuration
# ============================================
OS=alpine:3.22.2
ELIXIR_IMAGE=hexpm/elixir:1.19.2-erlang-28.1-alpine-3.22.2

# ============================================
# Security - CHANGE THESE IN PRODUCTION!
# ============================================
# Generate secure random passwords:
# openssl rand -base64 32

# Livebook password (access to interactive notebooks)
LIVEBOOK_PASSWORD=CHANGE_ME_secure_password_here

# Livebook secret key base (for session encryption)
# Generate with: openssl rand -base64 64
LIVEBOOK_SECRET_KEY_BASE=CHANGE_ME_generate_with_openssl_rand_base64_64

# Erlang distributed cookie (for clustering and remote shells)
# Generate with: openssl rand -base64 32
ERL_COOKIE=CHANGE_ME_erlang_cookie_for_production
RELEASE_COOKIE=CHANGE_ME_erlang_cookie_for_production

# ============================================
# MinIO (S3-Compatible Storage) - CHANGE THESE!
# ============================================
MINIO_ROOT_USER=CHANGE_ME_minio_admin_user
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_secure_password_min_8_chars
MINIO_ENDPOINT=http://minio:9000
MINIO_PORT=9000
MINIO_SCHEME=http://
MINIO_CONSOLE_PORT=9001

AWS_REGION=us-east-1
IMAGE_BUCKET=msvc-images
LOKI_CHUNKS=loki-chunks
IMAGE_BUCKET_MAX_AGE=3600

# ============================================
# NATS Configuration
# ============================================
NATS_HOST=nats-server
NATS_PORT=4222
NATS_CLUSTER_PORT=6222
NATS_JETSTREAM_ENABLED=true
NATS_JETSTREAM_STORE_DIR=/data/jetstream
NATS_JETSTREAM_MAX_MEM=2Gb
NATS_JETSTREAM_MAX_FILE=20Gb

# ============================================
# Service Ports
# ============================================
USER_SVC_PORT=8081
USER_SVC_HOST_PORT=8081

JOB_SVC_PORT=8082
JOB_SVC_HOST_PORT=8082

EMAIL_SVC_PORT=8083
EMAIL_SVC_HOST_PORT=8083

# Image Service Instances (Load Balanced)
IMAGE_SVC_PORT=8084
IMAGE_SVC_HOST_PORT=8084
IMAGE_SVC_2_PORT=8094
IMAGE_SVC_2_HOST_PORT=8094

CLIENT_SVC_PORT=8085
CLIENT_SVC_HOST_PORT=8085

# ============================================
# Service URLs (Internal Docker Networking)
# ============================================
USER_SVC_URL=http://user_svc:8081
JOB_SVC_URL=http://job_svc:8082
EMAIL_SVC_URL=http://email_svc:8083
IMAGE_SVC_URL=http://image_svc_1:8084
CLIENT_SVC_URL=http://client_svc:8085

# ============================================
# Grafana Configuration
# ============================================
# PRODUCTION: Set to false and configure proper authentication!
GF_AUTH_ANONYMOUS_ENABLED=false
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer
GF_AUTH_DISABLE_LOGIN_FORM=false

# Grafana admin credentials - CHANGE THESE!
GF_SECURITY_ADMIN_USER=CHANGE_ME_grafana_admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_grafana_secure_password

# ============================================
# OpenTelemetry Configuration
# ============================================
# Use gRPC for production (better performance)
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# Optional: Enable trace sampling (10% of requests)
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1

# ============================================
# Observability Stack Ports
# ============================================
GRAFANA_UI_PORT=3000
PROMETHEUS_UI_PORT=9090

# Tempo (Distributed Tracing)
TEMPO_UI_PORT=3200
TEMPO_OTLP_HTTP_PORT=4318
TEMPO_OTLP_GRPC_PORT=4317

# Jaeger (Tracing UI)
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4327
JAEGER_OTLP_HTTP_PORT=4328

# Loki (Log Aggregation)
LOKI_PORT=3100
PROMTAIL_PORT=9080

# ============================================
# API Documentation
# ============================================
SWAGGER_UI_PORT=8087
PAGE_TITLE="Microservices API Documentation"
SPEC_URL="specs/user_svc.yaml"

# ============================================
# Application Environment
# ============================================
MIX_ENV=prod
LOG_LEVEL=info
# LOG_FORMAT=json  # Uncomment for JSON structured logging

# ============================================
# Email Configuration (if using real SMTP)
# ============================================
# Uncomment and configure for production email sending
# MAILER_ADAPTER=smtp
# SMTP_RELAY=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password

# ============================================
# Database (Oban - SQLite)
# ============================================
DB_POOL_SIZE=10

# ============================================
# Performance Tuning
# ============================================
# Adjust based on your server resources
# ERL_MAX_PORTS=65536
# ERL_MAX_ETS_TABLES=50000
